devices:
  - name: "shelly-pro3em-house"
    address: "http://192.168.0.10"
    username: ""
    password: ""
    id: 0
    endpoints:
      - "rpc/EM.GetStatus?id=0"
      - "rpc/Sys.GetStatus"
      - "rpc/WiFi.GetStatus"

  - name: "shelly-laundry-room"
    address: "http://192.168.0.11"
    username: ""
    password: ""
    id: 0
    endpoints:
      - "rpc/PM1.GetStatus?id=0"
      - "rpc/Sys.GetStatus"
      - "rpc/WiFi.GetStatus"

server:
  listen_address: ":9905"
  request_timeout_seconds: 5
  # After a device answers with HTTP 429 (Too Many Requests), pause scraping it
  # for this long before trying again. Shelly firmware 2.0.0 can get stuck in a
  # "too many requests" state for several minutes; hammering it only prolongs it.
  rate_limit_cooldown_seconds: 600

metrics:
  enable_go_runtime: false
